DB_NAME=vulnerable_bank
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
VULNBANK_WEB_PORT=5000
VULNBANK_HTTP_PORT=80
XSS_PAYLOAD_TTL_MINUTES=15
XSS_CLEANUP_INTERVAL_SECONDS=60
DEEPSEEK_API_KEY=you_aint_gon_see_sheet

# Authentication (Module 1) secrets and settings.
# Set JWT_SECRET and FLASK_SECRET_KEY to long random values, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# If JWT_SECRET is unset the app generates a random one at startup, which is
# secure but invalidates existing sessions on every restart.
JWT_SECRET=
JWT_TTL_MINUTES=60
FLASK_SECRET_KEY=
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5000
# Set COOKIE_SECURE=false only for local HTTP testing; use true behind HTTPS.
COOKIE_SECURE=false
ADMIN_PASSWORD=admin123
